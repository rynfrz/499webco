# Copy to .env.local for local development.
# Local: an in-process Postgres (no setup, no production data):
DATABASE_URL=pglite://./.data/pg
# Production (Vercel): attach the Postgres store, which sets POSTGRES_URL for you.
SESSION_SECRET=replace-with-a-long-random-string
# Optional: a separate key for encrypting integration credentials (defaults to SESSION_SECRET)
# INTEGRATION_SECRET=
# Optional: lets a scheduler resume unfinished generation jobs via /api/cron/jobs
# CRON_SECRET=
